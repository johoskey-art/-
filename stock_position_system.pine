//@version=5
indicator("주가위치분석시스템 (Stock Position System) [v5]", overlay=true, max_lines_count=500, max_labels_count=500)

// ==========================================
// 1. 설정 및 파라미터 (Inputs)
// ==========================================
grp_base = "기준 이평선 설정 (무릎 기준축)"
ma_len   = input.int(300, "기준선 기간 (무릎선)", minval=50, maxval=500, group=grp_base)
ma_type  = input.string("TMA", "기준선 종류", options=["TMA (이중삼각평활)", "SMA (단순)", "EMA (지수)"], group=grp_base)

grp_sub  = "보조 이동평균선 (정배열 추세 확인)"
show_sub = input.bool(true, "보조 이평선 표시", group=grp_sub)
len_40   = input.int(40, "단기 40선", group=grp_sub)
len_50   = input.int(50, "수급 50선", group=grp_sub)
len_60   = input.int(60, "중기 60선", group=grp_sub)
len_120  = input.int(120, "경기 120선", group=grp_sub)

grp_pos  = "주가위치 7단계 배율 (역대 주도주 20선 실측 역산)"
ratio_gaksul = input.float(2.246, "각설이 역산 배율 (무릎 / 2.246)", step=0.001, group=grp_pos)
ratio_ankle  = input.float(1.531, "발목 역산 배율 (무릎 / 1.531)", step=0.001, group=grp_pos)
ratio_thigh  = input.float(1.581, "허벅지 배율 (무릎 * 1.581)", step=0.001, group=grp_pos)
ratio_waist  = input.float(1.618, "허리 배율 (허벅지 * 1.618)", step=0.001, group=grp_pos)
ratio_shldr  = input.float(1.406, "어깨 배율 (허리 * 1.406)", step=0.001, group=grp_pos)
ratio_top    = input.float(5.911, "상투 배율 (무릎 * 5.911 = 약 13.3배)", step=0.001, group=grp_pos)

grp_ui   = "시각화 및 대시보드"
show_table  = input.bool(true, "실시간 요약 정보표 표시", group=grp_ui)
table_pos   = input.string("우측 상단", "테이블 위치", options=["우측 상단", "우측 하단", "좌측 상단"], group=grp_ui)
show_marker = input.bool(true, "핵심 타점 시그널 마커 표시", group=grp_ui)

// ==========================================
// 2. 이동평균선 계산
// ==========================================
f_calc_ma(src, len, type) =>
    if type == "TMA (이중삼각평활)"
        ta.sma(ta.sma(src, math.ceil(len / 2)), math.floor(len / 2) + 1)
    else if type == "EMA (지수)"
        ta.ema(src, len)
    else
        ta.sma(src, len)

// 기준선 (무릎 = 2.25배 중심축)
line_knee = f_calc_ma(close, ma_len, ma_type)

// 보조 이평선
ma40  = ta.sma(close, len_40)
ma50  = ta.sma(close, len_50)
ma60  = ta.sma(close, len_60)
ma120 = ta.sma(close, len_120)

// 주가위치 7단계 라인 계산
line_gaksul = line_knee / ratio_gaksul                    // 1. 각설이 (바닥권)
line_ankle  = line_knee / ratio_ankle                     // 2. 발목 (1차 턴어라운드)
line_thigh  = line_knee * ratio_thigh                     // 4. 허벅지 (본격 분출)
line_waist  = line_thigh * ratio_waist                    // 5. 허리 (중간 눌림/지지)
line_shldr  = line_waist * ratio_shldr                    // 6. 어깨 (분할 매도)
line_top    = line_knee * ratio_top                       // 7. 상투 (최종 고점 과열권)

// ==========================================
// 3. 플롯 (Plotting)
// ==========================================
// 주가위치 7단계 선
p_top    = plot(line_top,    "7. 상투선 (13.3배 고점)",  color=color.new(#FF1744, 0), linewidth=2, style=plot.style_line)
p_shldr  = plot(line_shldr,  "6. 어깨선 (8.06배 분할매도)", color=color.new(#FF9100, 15), linewidth=2, style=plot.style_line)
p_waist  = plot(line_waist,  "5. 허리선 (5.73배 중간지지)", color=color.new(#FFD600, 20), linewidth=2, style=plot.style_line)
p_thigh  = plot(line_thigh,  "4. 허벅지선 (3.55배 본격분출)", color=color.new(#00E676, 25), linewidth=2, style=plot.style_line)
p_knee   = plot(line_knee,   "3. 무릎선 (기준축 300일선)", color=color.new(#2979FF, 0), linewidth=3, style=plot.style_line)
p_ankle  = plot(line_ankle,  "2. 발목선 (1.47배 턴어라운드)", color=color.new(#00E5FF, 30), linewidth=2, style=plot.style_line)
p_gaksul = plot(line_gaksul, "1. 각설이선 (1.00배 바닥권)", color=color.new(#7C4DFF, 10), linewidth=2, style=plot.style_line)

// 채우기 (배경색 그라데이션)
fill(p_top, p_shldr, color.new(#FF1744, 88), "과열 매도구간")
fill(p_waist, p_thigh, color.new(#FFD600, 90), "시세 중간구간")
fill(p_knee, p_ankle, color.new(#2979FF, 88), "적극 매수구간")

// 보조 이평선 플롯
plot(show_sub ? ma40 : na,  "40선 (단기)", color=color.new(#F06292, 50), linewidth=1)
plot(show_sub ? ma50 : na,  "50선 (수급)", color=color.new(#BA68C8, 50), linewidth=1)
plot(show_sub ? ma60 : na,  "60선 (중기)", color=color.new(#FFB74D, 50), linewidth=1)
plot(show_sub ? ma120 : na, "120선 (경기)", color=color.new(#90A4AE, 40), linewidth=1)

// ==========================================
// 4. 매매 시그널 로직 및 마커
// ==========================================
// 발목 턴어라운드: 주가가 발목선을 상향 돌파
sig_ankle_turn = ta.crossover(close, line_ankle)

// 무릎 추세 돌파: 주가가 무릎선(300선) 상향 돌파 (가장 핵심 매수 타점)
sig_knee_break = ta.crossover(close, line_knee)

// 허리 눌림목 지지: 주가가 허리선 근처에서 반등
sig_waist_bounce = (low <= line_waist) and (close > line_waist) and (close > open)

// 어깨/상투 과열 경고: 주가가 어깨선/상투선 돌파
sig_top_alert = ta.crossover(close, line_shldr) or ta.crossover(close, line_top)

plotshape(show_marker and sig_ankle_turn, "발목 턴어라운드", shape.triangleup, location.belowbar, color.new(#00E5FF, 0), size=size.small, text="발목")
plotshape(show_marker and sig_knee_break, "무릎 돌파 (핵심매수)", shape.labelup, location.belowbar, color.new(#2979FF, 0), size=size.normal, text="무릎돌파", textcolor=color.white)
plotshape(show_marker and sig_top_alert, "상투/어깨 과열경고", shape.labeldown, location.abovebar, color.new(#FF1744, 0), size=size.normal, text="분할익절", textcolor=color.white)

// 알림 (Alerts)
alertcondition(sig_knee_break, "무릎 돌파 발생", "★ 주가위치시스템: 무릎선(300일선) 상향 돌파 매수 타점 발생!")
alertcondition(sig_top_alert,  "어깨/상투 도달", "▲ 주가위치시스템: 어깨/상투 구간 도달 - 분할 익절 권고!")

// ==========================================
// 5. 실시간 상태 판별 및 정보표 (Dashboard Table)
// ==========================================
var string current_stage = "각설이 (바닥권)"
var color stage_color    = color.purple

if close >= line_top
    current_stage := "🚨 7. 상투 (최종 과열)"
    stage_color   := color.red
else if close >= line_shldr
    current_stage := "⚠️ 6. 어깨 (분할 매도)"
    stage_color   := color.orange
else if close >= line_waist
    current_stage := "⭐ 5. 허리 (중간 눌림/지지)"
    stage_color   := color.yellow
else if close >= line_thigh
    current_stage := "🚀 4. 허벅지 (본격 분출)"
    stage_color   := color.green
else if close >= line_knee
    current_stage := "🔥 3. 무릎 (추세 돌파 성공)"
    stage_color   := color.blue
else if close >= line_ankle
    current_stage := "🌱 2. 발목 (1차 턴어라운드)"
    stage_color   := color.teal
else
    current_stage := "❄️ 1. 각설이 (바닥 수렴)"
    stage_color   := color.purple

// 300일선 이격도 및 잔여 상승 여력
ratio_to_knee = ((close - line_knee) / line_knee) * 100
gain_to_top   = ((line_top - close) / close) * 100

if show_table and barstate.islast
    t_pos = table_pos == "우측 상단" ? position.top_right : table_pos == "우측 하단" ? position.bottom_right : position.top_left
    var table stat_tbl = table.new(t_pos, 2, 7, bgcolor=color.new(#1E222D, 10), border_color=color.new(#363A45, 0), border_width=1)
    
    table.cell(stat_tbl, 0, 0, "주가위치분석시스템", bgcolor=color.new(#2962FF, 20), text_color=color.white, text_size=size.small)
    table.cell(stat_tbl, 1, 0, "실시간 진단", bgcolor=color.new(#2962FF, 20), text_color=color.white, text_size=size.small)
    
    table.cell(stat_tbl, 0, 1, "현재 진단 단계", text_color=color.white, text_size=size.small)
    table.cell(stat_tbl, 1, 1, current_stage, bgcolor=stage_color, text_color=color.white, text_size=size.small)
    
    table.cell(stat_tbl, 0, 2, "현재 주가", text_color=color.gray, text_size=size.small)
    table.cell(stat_tbl, 1, 2, str.tostring(close, "#,###"), text_color=color.white, text_size=size.small)
    
    table.cell(stat_tbl, 0, 3, "무릎선 (300선)", text_color=color.gray, text_size=size.small)
    table.cell(stat_tbl, 1, 3, str.tostring(line_knee, "#,###"), text_color=#2979FF, text_size=size.small)
    
    table.cell(stat_tbl, 0, 4, "무릎 대비 이격", text_color=color.gray, text_size=size.small)
    table.cell(stat_tbl, 1, 4, (ratio_to_knee >= 0 ? "+" : "") + str.tostring(ratio_to_knee, "#.##") + "%", text_color=(ratio_to_knee >= 0 ? color.red : color.blue), text_size=size.small)
    
    table.cell(stat_tbl, 0, 5, "상투 목표가 (13.3배)", text_color=color.gray, text_size=size.small)
    table.cell(stat_tbl, 1, 5, str.tostring(line_top, "#,###"), text_color=#FF1744, text_size=size.small)
    
    table.cell(stat_tbl, 0, 6, "상투까지 잔여여력", text_color=color.gray, text_size=size.small)
    table.cell(stat_tbl, 1, 6, (gain_to_top >= 0 ? "+" : "") + str.tostring(gain_to_top, "#.##") + "%", text_color=(gain_to_top >= 0 ? #00E676 : color.gray), text_size=size.small)
